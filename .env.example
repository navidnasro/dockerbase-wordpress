# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_ALLOW_EMPTY_PASSWORD=true
MYSQL_DATABASE=wordpress
MYSQL_USER=admin
MYSQL_PASSWORD=password

# Ports
NGINX_PORT=80
PHPMYADMIN_PORT=8083

# WordPress
WORDPRESS_DB_HOST=mysql:3306
WP_HOME=http://wordpress-example.com
WP_SITEURL=http://wordpress-example.com
WORDPRESS_DEBUG=1
WPLANG=fa_IR
WP_TABLE_PREFIX=wp_
WP_POST_REVISIONS=5
AUTOSAVE_INTERVAL=120
WP_MEMORY_LIMIT=256M
DISALLOW_FILE_EDIT=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false